+#ifdef CONFIG_STACKCHAN_CODEX_VOICE_USB
+void Application::UpdateCodexProgress(int job_id, int sequence, const std::string& text) {
+    if (job_id != codex_request_id_ || !codex_task_pending_ ||
+        sequence <= codex_progress_sequence_ || text.empty() || text.size() > 600) {
+        return;
+    }
+    codex_progress_sequence_ = sequence;
+    codex_task_progress_ = text;
+    codex_progress_unread_ = true;
+    if (!codex_announce_pending_) {
+        codex_announce_deadline_us_ = 0;
+    }
+    codex_announce_pending_ = true;
+    // If the speech session ended, reconnect for this update when idle.
+    ESP_LOGI("CodexVoice", "PROGRESS job=%d seq=%d stored", job_id, sequence);
+    if (codex_status_request_id_ >= 0) {
+        ReplyCodexStatus(codex_status_request_id_);
+    }
+}
+
+void Application::CompleteCodexTask(int job_id, const std::string& text) {
+    if (job_id != codex_request_id_) {
+        ESP_LOGW("CodexVoice", "Ignoring stale task result");
+        return;
+    }
+    if (!codex_task_pending_) {
+        ESP_LOGI("CodexVoice", "RESULT job=%d stored", job_id);
+        return;
+    }
+    // Store completion before touching the network. It remains queryable if
+    // the cloud session disconnected while Codex was working.
+    codex_task_result_ = text;
+    codex_task_pending_ = false;
+    codex_progress_unread_ = false;
+    codex_task_progress_.clear();
+    codex_announce_pending_ = true;
+    codex_announce_deadline_us_ = 0;
+    ESP_LOGI("CodexVoice", "RESULT job=%d stored", job_id);
+    if (codex_status_request_id_ >= 0) {
+        ReplyCodexStatus(codex_status_request_id_);
+    }
+}
+
+void Application::ReplyCodexStatus(int request_id) {
+    codex_status_request_id_ = -1;
+    const bool has_progress = codex_task_pending_ && codex_progress_unread_;
+    const char* status = has_progress ? "progress" : codex_task_pending_ ? "running" :
+                         (codex_request_id_ == 0 ? "idle" : "completed");
+    auto* state = cJSON_CreateObject();
+    cJSON_AddNumberToObject(state, "job_id", codex_request_id_);
+    cJSON_AddStringToObject(state, "status", status);
+    if (has_progress) {
+        cJSON_AddStringToObject(state, "progress", codex_task_progress_.c_str());
+        cJSON_AddStringToObject(state, "summary", codex_task_progress_.c_str());
+        cJSON_AddBoolToObject(state, "read_aloud", true);
+        cJSON_AddStringToObject(state, "next_action",
+            "先向用户简短播报 summary 中的实际执行进度，再调用 self.codex.result。任务仍在执行。不得跳过播报直接查询。");
+        cJSON_AddNumberToObject(state, "progress_seq", codex_progress_sequence_);
+        codex_progress_unread_ = false;
+        codex_announce_pending_ = false;
+    } else if (!codex_task_pending_) {
+        codex_announce_pending_ = false;
+        cJSON_AddStringToObject(state, "summary", codex_task_result_.c_str());
+    }
+    auto* text = cJSON_PrintUnformatted(state);
+    cJSON_Delete(state);
+    if (!text) {
+        return;
+    }
+    SendBridgeToolResult(request_id, text, false);
+    cJSON_free(text);
+    ESP_LOGI("CodexVoice", "STATUS request=%d job=%d status=%s",
+             request_id, codex_request_id_, status);
+}
+
+void Application::CompleteThetaQuery(int job_id, const std::string& text, bool is_error) {
+    if (theta_request_id_ < 0 || job_id != theta_job_id_) {
+        ESP_LOGW("ThetaVoice", "Ignoring stale query result job=%d", job_id);
+        return;
+    }
+    const int request_id = theta_request_id_;
+    theta_request_id_ = -1;
+    SendBridgeToolResult(request_id, text.c_str(), is_error);
+    ESP_LOGI("ThetaVoice", "RESULT request=%d job=%d error=%d", request_id, job_id, is_error);
+}
+
+void Application::CompleteFutuQuery(int job_id, const std::string& text, bool is_error) {
+    if (futu_request_id_ < 0 || job_id != futu_job_id_) {
+        ESP_LOGW("FutuVoice", "Ignoring stale query result job=%d", job_id);
+        return;
+    }
+    const int request_id = futu_request_id_;
+    futu_request_id_ = -1;
+    SendBridgeToolResult(request_id, text.c_str(), is_error);
+    ESP_LOGI("FutuVoice", "RESULT request=%d job=%d error=%d", request_id, job_id, is_error);
+}
+
+void Application::SendBridgeToolResult(int request_id, const char* text, bool is_error) {
+    auto* response = cJSON_CreateObject();
+    cJSON_AddStringToObject(response, "jsonrpc", "2.0");
+    cJSON_AddNumberToObject(response, "id", request_id);
+    auto* result = cJSON_AddObjectToObject(response, "result");
+    auto* content = cJSON_AddArrayToObject(result, "content");
+    auto* item = cJSON_CreateObject();
+    cJSON_AddStringToObject(item, "type", "text");
+    cJSON_AddStringToObject(item, "text", text);
+    cJSON_AddItemToArray(content, item);
+    cJSON_AddBoolToObject(result, "isError", is_error);
+    if (auto* json = cJSON_PrintUnformatted(response)) {
+        // Reopen the UDP return path for every short status response.
+        if (dynamic_cast<MqttProtocol*>(protocol_.get())) {
+            auto silence = std::make_unique<AudioStreamPacket>();
+            silence->payload = {0xbb, 0x03, 0xff, 0xfe, 0xff, 0xfe, 0xff, 0xfe};
+            if (!protocol_->SendAudio(std::move(silence))) {
+                ESP_LOGW("CodexVoice", "Audio return path unavailable; result remains cached");
+            }
+        }
+        codex_audio_packets_ = 0;
+        codex_readback_ = true;
+        aborted_ = false;
+        extern void stackchan_arm_chat_output();
+        stackchan_arm_chat_output();
+        SetDeviceState(kDeviceStateSpeaking);
+        SendMcpMessage(json);
+        cJSON_free(json);
+    }
+    cJSON_Delete(response);
+}
+#endif
+
+void Application::SendChatText(const std::string& text) {
+    if (!protocol_ || GetDeviceState() != kDeviceStateIdle) {
+        ESP_LOGW(TAG, "USB chat unavailable or busy");
+        return;
+    }
+    if (!protocol_->IsAudioChannelOpened() && !protocol_->OpenAudioChannel()) {
+        ESP_LOGW(TAG, "USB chat channel failed");
+        return;
+    }
+    // The MQTT service needs an outbound UDP packet to learn the NAT return path.
+    // Prime it with 60 ms of Opus silence, without opening the microphone.
+    if (dynamic_cast<MqttProtocol*>(protocol_.get())) {
+        auto silence = std::make_unique<AudioStreamPacket>();
+        silence->payload = {0xbb, 0x03, 0xff, 0xfe, 0xff, 0xfe, 0xff, 0xfe};
+        if (!protocol_->SendAudio(std::move(silence))) {
+            ESP_LOGW(TAG, "USB chat channel failed");
+            protocol_->CloseAudioChannel();
+            return;
+        }
+    }
+    listening_mode_ = kListeningModeManualStop;
+    extern void stackchan_arm_chat_output();
+    stackchan_arm_chat_output();
+    protocol_->SendWakeWordDetected(text);
+    ESP_LOGI(TAG, "USB chat text submitted");
 }
 
